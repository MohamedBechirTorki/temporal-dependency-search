# Copy to .env and adjust. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# MongoDB (single-node replica set "rs0" is required for transactions)
MONGO_PORT=27018
MONGO_URI=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
MONGO_DB=temporal_deps
MONGO_MAX_POOL_SIZE=50
MONGO_RS_HOST=localhost

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_HEAP=1G
NEO4J_PAGECACHE=1G

# Engine behaviour
CYCLE_POLICY=allow            # allow | warn | reject
MAX_TRAVERSAL_DEPTH=25
SYNC_WORKER_ENABLED=true
SYNC_POLL_INTERVAL_SECONDS=0.5
SYNC_MAX_ATTEMPTS=8
SYNC_BATCH_SIZE=200

API_PORT=8000
